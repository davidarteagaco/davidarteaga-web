{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/quien-soy",
      "destination": "/#quien-soy",
      "permanent": true
    },
    {
      "source": "/testimonios",
      "destination": "/#casos",
      "permanent": true
    },
    {
      "source": "/catalogo",
      "destination": "/#inicio",
      "permanent": true
    },
    {
      "source": "/finanzas/productividad-laboral",
      "destination": "/finanzas/productividad-laboral-pl/",
      "permanent": true
    },
    {
      "source": "/fabricas",
      "destination": "/fabricas-de-productividad/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(og.png|favicon.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/finanzas/(fin.css|fin.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
