{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/quien-soy",
      "destination": "/#quien-soy",
      "permanent": true
    },
    {
      "source": "/testimonios",
      "destination": "/#casos",
      "permanent": true
    },
    {
      "source": "/catalogo",
      "destination": "/#inicio",
      "permanent": true
    },
    {
      "source": "/finanzas/productividad-laboral",
      "destination": "/finanzas/productividad-laboral-pl/",
      "permanent": true
    },
    {
      "source": "/fabricas",
      "destination": "/fabricas-de-productividad/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
